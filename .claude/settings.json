{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/design-gate.js",
            "if": "Bash(git commit*)",
            "statusMessage": "Checking design artifacts (AI-native SDLC gate)..."
          },
          {
            "type": "command",
            "command": "node .claude/hooks/review-gate.js",
            "if": "Bash(git push*)",
            "statusMessage": "Checking review artifact (AI-native SDLC gate)..."
          }
        ]
      }
    ]
  }
}
